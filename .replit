modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "User Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Restaurant Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Order Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Delivery Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ML Service"

[[workflows.workflow]]
name = "User Service"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd services/user-service && npm run start:dev"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Restaurant Service"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd services/restaurant-service && npm run start:dev"
waitForPort = 3002

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Order Service"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd services/order-service && npm run start:dev"
waitForPort = 3003

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Delivery Service"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd services/delivery-service && npm run start:dev"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "ML Service"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd services/ml-service && uvicorn app.main:app --host 0.0.0.0 --port 3005"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 3004
externalPort = 3000

[[ports]]
localPort = 3005
externalPort = 4200

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
JWT_SECRET = "super_secret_key"
JWT_EXPIRES_IN = "1d"
USER_SERVICE_URL = "http://localhost:3001"
RESTAURANT_SERVICE_URL = "http://localhost:3002"
ORDER_SERVICE_URL = "http://localhost:3003"
DELIVERY_SERVICE_URL = "http://localhost:3004"
ML_SERVICE_URL = "http://localhost:3005"
