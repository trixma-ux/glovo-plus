generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  EN_ATTENTE
  VALIDEE
  PREPARATION
  LIVRAISON
  LIVREE
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  restaurantId String
  totalAmount  Float
  status       OrderStatus @default(EN_ATTENTE)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Float
  quantity    Int
  subtotal    Float
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}
